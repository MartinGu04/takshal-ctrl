# ─────────────────────────── Destinations (optional) ───────────────────────────
# By default the portal links to the production systems defined in
# src/shared/destinations.ts (DEFAULT_DESTINATIONS):
#   Avaria  → https://takalot.vercel.app/
#   המחלבה  → https://luzly.vercel.app/
# Override only for staging. Absolute http(s) URLs or same-origin paths are accepted.
# VITE_AVARIA_URL=https://takalot.vercel.app/
# VITE_MACHLAVA_URL=https://luzly.vercel.app/

# ─────────────────────────── Notification Hub ───────────────────────────
# Client (public, bundled into the app). Safe to expose: the hub tables are closed to the
# anon/publishable key by RLS and revoked privileges.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>          # npm run vapid:generate

# Server only (Vercel Functions). NEVER prefix these with VITE_ and never commit real values.
# SUPABASE_URL defaults to VITE_SUPABASE_URL when omitted.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:you@example.com
